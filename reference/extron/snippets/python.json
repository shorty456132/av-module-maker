{
	"Slider Changed Event": {
		"prefix": "Extron Event Slider Changed",
		"body": [
			"@${1|event,eventEx|}(${2:SliderObject}, 'Changed')",
			"def ${2}Changed(${3:slider}, ${4:state}, ${5:value}):",
			"\tprint(${3}.Name, ${4}, ${5})\n\t$0"
		],
		"description": "Definition of Slider Changed event handler."
	},
	"Event Template": {
		"prefix": "Extron Event Template",
		"body": [
			"@${1|event,eventEx|}(${2:SomeObject}, 'EventName')",
			"def ${3:HandlerFunction}(${4:actor}, ${5:eventname}):",
			"\t${6:pass}$0\n"
		],
		"description": "Definition of event handler."
	},
