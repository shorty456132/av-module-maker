	"Define Button":{
		"prefix": "Extron Button Instantiation",
		"body":[
			"${1:ButtonName} = Button(${2:PanelName}, ${3:1}, holdTime=${4:None}, repeatTime=${5:None})\n$0"
		],
		"description": "Insert Button Definition"
	},
	"Define Button Range":{
		"prefix": "Extron Button Range Instantiation",
		"body":[
			"${1:ButtonListName} = [Button(${2:PanelName}, btnID, holdTime=${4:None}, repeatTime=${5:None}) for btnID in range(${6:10001}, ${7:10011})]\n$0"
		],
		"description": "Insert Object List of Buttons by Range"
	},
