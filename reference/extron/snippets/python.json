	"Wait Decorator": {
		"prefix": "Extron WaitDecorator",
		"body": [
			"@Wait(${1:1})",
			"def ${2:WaitHandlerName}():",
			"\t${3:pass}$0\n"
		],
		"description": "Instantiation of a Wait object."
	},
	"Timer Decorator": {
		"prefix": "Extron TimerDecorator",
		"body": [
			"@Timer(${1:1})",
			"def ${2:TimerHandlerName}(timer, count):",
			"\t${3:pass}$0\n"
		],
		"description": "Instantiation of a Timer object."
	}
